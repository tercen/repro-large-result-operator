{
  "name": "Large Result Repro (sci#1685)",
  "description": "sci#1685 stage repro harness: emits an OperatorResult of up to 1000 double columns per input row; point size driven by input rows (8 bytes/cell). No analysis value.",
  "tags": [
    "repro",
    "harness"
  ],
  "authors": [
    "tercen"
  ],
  "urls": [
    "https://github.com/tercen/repro-large-result-operator"
  ],
  "properties": [
    {
      "kind": "DoubleProperty",
      "name": "n_cols",
      "defaultValue": 999.0,
      "description": "Number of double output columns; cap is 999 \u2014 the 1000-column table limit includes the .ci column. Point size is driven by input rows: bytes ~= 8 * n_rows * n_cols."
    }
  ],
  "operatorSpec": {
    "kind": "OperatorSpec",
    "ontologyUri": "https://tercen.com/_ontology/tercen",
    "ontologyVersion": "0.0.1",
    "inputSpecs": [
      {
        "kind": "CrosstabSpec",
        "metaFactors": [
          {
            "kind": "MetaFactor",
            "name": "Observation identifier",
            "type": "",
            "description": "Observation identifiers",
            "ontologyMapping": "observation",
            "crosstabMapping": "row",
            "cardinality": "1..n",
            "factors": []
          }
        ],
        "axis": [
          {
            "kind": "AxisSpec",
            "metaFactors": [
              {
                "kind": "MetaFactor",
                "name": "Measurement",
                "type": "double",
                "description": "Placeholder measurement (ignored by the operator)",
                "ontologyMapping": "measurement",
                "crosstabMapping": "y",
                "cardinality": "1",
                "factors": []
              }
            ]
          }
        ]
      }
    ],
    "outputSpecsV2": [
      {
        "kind": "OperatorJoinSpec",
        "joinOperators": [
          {
            "kind": "JoinOperator",
            "joinType": "left",
            "leftPair": {
              "kind": "ColumnPair",
              "lColumns": [
                "Observation identifier"
              ],
              "rColumns": [
                "Observation identifier"
              ]
            },
            "rightRelation": {
              "kind": "TableRelation",
              "attributes": [
                {
                  "kind": "Attribute",
                  "name": "v1",
                  "type": "double"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}